{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "cluster": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "enum": [
            "aarch64",
            "ppc64le",
            "s390x",
            "x86_64",
            "amd64",
            "arm64"
          ],
          "type": "string"
        },
        "hypershift": {
          "type": "boolean"
        },
        "ocpVersion": {
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "type": "string"
        }
      },
      "required": [
        "ocpVersion",
        "architecture",
        "hypershift"
      ],
      "type": "object"
    },
    "complianceNamespace": {
      "type": "string"
    },
    "profileRules": {
      "type": "object"
    },
    "profileVariables": {
      "type": "object"
    },
    "profiles": {
      "additionalProperties": false,
      "properties": {
        "ocp4-bsi": {
          "type": "boolean"
        },
        "ocp4-bsi-2022": {
          "type": "boolean"
        },
        "ocp4-cis": {
          "type": "boolean"
        },
        "ocp4-cis-1-7": {
          "type": "boolean"
        },
        "ocp4-cis-1-9": {
          "type": "boolean"
        },
        "ocp4-e8": {
          "type": "boolean"
